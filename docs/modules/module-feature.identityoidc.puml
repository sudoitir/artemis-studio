@startuml
title <size:24>Single sign-on</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("RahdarApplication_boundary", "RahdarApplication", $tags="") {
