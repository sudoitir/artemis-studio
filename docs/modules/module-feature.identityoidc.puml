    Component(RahdarApplication.RahdarApplication.Plugincontract, "Plugin contract", $techn="Module", $descr="", $tags="", $link="")
    Component(RahdarApplication.RahdarApplication.Security, "Security", $techn="Module", $descr="", $tags="", $link="")
    Component(RahdarApplication.RahdarApplication.Singlesignon, "Single sign-on", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(RahdarApplication.RahdarApplication.Security, RahdarApplication.RahdarApplication.Plugincontract, "listens to", $techn="", $tags="", $link="")
Rel(RahdarApplication.RahdarApplication.Security, RahdarApplication.RahdarApplication.Plugincontract, "uses", $techn="", $tags="", $link="")
Rel(RahdarApplication.RahdarApplication.Singlesignon, RahdarApplication.RahdarApplication.Plugincontract, "depends on", $techn="", $tags="", $link="")
Rel(RahdarApplication.RahdarApplication.Singlesignon, RahdarApplication.RahdarApplication.Security, "uses", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
