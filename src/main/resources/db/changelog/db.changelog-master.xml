<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Master changelog: one include per module, in dependency order (ADR-0072). A
      module owns its tables; its changelog lives beside its changesets under
      db/changelog/<module>/, and a new module adds one include here.

      Conventions for every changeset (see docs/adr/0008):
        * One logical concern per file, inside the module that owns the table.
        * Columns are ordered to minimise Postgres row padding: 8-byte-aligned
          types first (timestamptz, bigint, double precision), then 4-byte
          (integer, and the varlena types text/jsonb/bytea/inet), then the
          1-byte-aligned uuid and boolean last. The readability cost (primary
          key not first) is deliberate and worth it on the wide, high-row tables.
        * High-churn tables carry per-table autovacuum and fillfactor storage
          parameters, set in the same file as the table.
        * A cross-module foreign key follows an allowed module dependency.
        * Never edit a released changeset. Add a new one.
    -->

    <include file="db/changelog/kernel/core/changelog.xml"          relativeToChangelogFile="false"/>
    <include file="db/changelog/kernel/security/changelog.xml"      relativeToChangelogFile="false"/>
    <include file="db/changelog/kernel/audit/changelog.xml"         relativeToChangelogFile="false"/>
    <include file="db/changelog/kernel/settings/changelog.xml"      relativeToChangelogFile="false"/>
    <include file="db/changelog/platform/governance/changelog.xml"  relativeToChangelogFile="false"/>
    <include file="db/changelog/platform/clusters/changelog.xml"    relativeToChangelogFile="false"/>
    <include file="db/changelog/platform/scrape/changelog.xml"      relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/apitokens/changelog.xml"    relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/events/changelog.xml"       relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/alerting/changelog.xml"     relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/rr/changelog.xml"           relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/sql/changelog.xml"          relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/brokerconfig/changelog.xml" relativeToChangelogFile="false"/>
    <include file="db/changelog/feature/flow/changelog.xml"         relativeToChangelogFile="false"/>

</databaseChangeLog>
