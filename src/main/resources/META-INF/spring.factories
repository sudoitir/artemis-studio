# Bootstrap-phase configuration (ADR-0047). Registered here rather than as an
# @Bean because the bootstrap context is built before component scanning happens.
org.springframework.cloud.bootstrap.BootstrapConfiguration=\
io.github.sudoitir.artemisstudio.kernel.settings.internal.JdbcConfigPropertySourceConfiguration

# Masks credential-like values in every Logback pattern word, before Boot configures logging (ADR-0133).
org.springframework.context.ApplicationListener=\
io.github.sudoitir.artemisstudio.kernel.core.internal.RedactingLogging
