<?xml version="1.0"?>
<!--
  DEV primary broker — partial config, XML-merged by the apache/activemq-artemis
  image over its generated broker.xml (files in etc-override/ are merged, not
  replaced).

  Purpose: give Artemis Studio a real replication primary/backup pair to discover,
  with Jolokia (:8161) and Core (:61616) reachable. Credentials artemis/artemis.

  UNVERIFIED in the setup session. Phase 0 boots this pair, confirms the backup
  reports Active=false while the primary reports Active=true, kills the primary,
  and confirms failover — fixing whatever the image needs here.
-->
<configuration xmlns="urn:activemq"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <core xmlns="urn:activemq:core">

    <name>primary</name>

    <persistence-enabled>true</persistence-enabled>
    <journal-type>ASYNCIO</journal-type>

    <!-- Replication HA, primary side. check-for-active-server avoids a
         double-primary on restart. -->
    <ha-policy>
      <replication>
        <primary>
          <check-for-active-server>true</check-for-active-server>
        </primary>
      </replication>
    </ha-policy>

    <connectors>
      <connector name="primary-connector">tcp://artemis-primary:61616</connector>
      <connector name="backup-connector">tcp://artemis-backup:61616</connector>
    </connectors>

    <cluster-connections>
      <cluster-connection name="studio-dev">
        <connector-ref>primary-connector</connector-ref>
        <message-load-balancing>ON_DEMAND</message-load-balancing>
        <max-hops>1</max-hops>
        <static-connectors>
          <connector-ref>backup-connector</connector-ref>
        </static-connectors>
      </cluster-connection>
    </cluster-connections>

    <!-- Management over the wire (activemq.management) needs the manage
         permission; the notifications address needs consume. -->
    <security-settings>
      <security-setting match="activemq.management.#">
        <permission type="manage" roles="amq"/>
        <permission type="send"   roles="amq"/>
        <permission type="consume" roles="amq"/>
        <permission type="createNonDurableQueue" roles="amq"/>
        <permission type="createAddress" roles="amq"/>
      </security-setting>
      <security-setting match="activemq.notifications">
        <permission type="consume" roles="amq"/>
      </security-setting>
    </security-settings>

  </core>
</configuration>
