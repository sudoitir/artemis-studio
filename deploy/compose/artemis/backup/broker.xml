<?xml version="1.0"?>
<!--
  DEV backup broker — partial config, XML-merged over the image's generated
  broker.xml. Pairs with ../primary/broker.xml. See that file's header.
-->
<configuration xmlns="urn:activemq"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <core xmlns="urn:activemq:core">

    <name>backup</name>

    <persistence-enabled>true</persistence-enabled>
    <journal-type>ASYNCIO</journal-type>

    <ha-policy>
      <replication>
        <backup>
          <allow-failback>true</allow-failback>
        </backup>
      </replication>
    </ha-policy>

    <connectors>
      <connector name="backup-connector">tcp://artemis-backup:61616</connector>
      <connector name="primary-connector">tcp://artemis-primary:61616</connector>
    </connectors>

    <cluster-connections>
      <cluster-connection name="studio-dev">
        <connector-ref>backup-connector</connector-ref>
        <message-load-balancing>ON_DEMAND</message-load-balancing>
        <max-hops>1</max-hops>
        <static-connectors>
          <connector-ref>primary-connector</connector-ref>
        </static-connectors>
      </cluster-connection>
    </cluster-connections>

    <security-settings>
      <security-setting match="activemq.management.#">
        <permission type="manage" roles="amq"/>
        <permission type="send"   roles="amq"/>
        <permission type="consume" roles="amq"/>
        <permission type="createNonDurableQueue" roles="amq"/>
        <permission type="createAddress" roles="amq"/>
      </security-setting>
      <security-setting match="activemq.notifications">
        <permission type="consume" roles="amq"/>
      </security-setting>
    </security-settings>

  </core>
</configuration>
