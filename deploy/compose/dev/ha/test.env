# The failover test's stack (compose.ha.test.yaml). DB_PASSWORD and SECRET_KEY are not here: `just ha-failover`
# and CI generate them for each run and pass them through the environment.
DB_NAME=artemis_studio
DB_USER=artemis_studio
STUDIO_IMAGE=artemis-studio:ci
JAVA_OPTS=-XX:MaxRAMPercentage=50 -XX:MaxMetaspaceSize=384m
