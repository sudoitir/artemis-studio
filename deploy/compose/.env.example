# Copy to .env next to this file and fill in. Used by compose.prod.yaml.

# Database
DB_NAME=artemis_studio
DB_USER=artemis_studio
DB_PASSWORD=change-me

# 32+ char key used to encrypt broker credentials at rest (AES-GCM).
# Generate: openssl rand -base64 48
SECRET_KEY=change-me

# Image to run. Pin a version for real deployments.
STUDIO_IMAGE=ghcr.io/sudoitir/artemis-studio:latest

# Where to publish the UI. Keep it on localhost and put a TLS proxy in front.
STUDIO_BIND=127.0.0.1:8080

JAVA_OPTS=-XX:MaxRAMPercentage=75
