# Copy to .env next to this file and fill in. Used by compose.prod.yaml.

# Database
DB_NAME=rahdar
DB_USER=rahdar
DB_PASSWORD=change-me

# Protects every stored secret at rest (AES-256-GCM envelope encryption, ADR-0132).
# MUST be base64 of exactly 32 bytes or the app will not start. To hold several versions
# for key rotation, use 1=<b64>,2=<b64> and keep the old version until a rotation succeeds.
# Generate: openssl rand -base64 32
SECRET_KEY=change-me

# Image to run. :dev is the moving pre-stable tag; pin a CalVer tag for real
# deployments, e.g. sudoit1/rahdar:2026.09.0
RAHDAR_IMAGE=sudoit1/rahdar:dev

# The broker role Rahdar's own broker user holds. Needed only for message capture:
# capture queues are restricted to this role, and capture is refused until it is set.
# Give Rahdar's broker user a dedicated role rather than the default `amq`.
CAPTURE_BROKER_ROLE=

# Where to publish the UI. Keep it on localhost and put a TLS proxy in front.
RAHDAR_BIND=127.0.0.1:8080

# Half the container limit for heap: the rest covers metaspace, code cache, GC
# structures, direct buffers and thread stacks.
JAVA_OPTS=-XX:MaxRAMPercentage=50 -XX:MaxMetaspaceSize=384m

# OpenTelemetry: export Rahdar's own metrics, traces and logs over OTLP (site/src/guide/observability.md).
# The standard SDK variables; an empty one is unset, so nothing is exported until you fill them in.
# true turns the OpenTelemetry SDK off entirely.
OTEL_SDK_DISABLED=
# Service name and extra resource attributes on everything exported (default name: rahdar).
OTEL_SERVICE_NAME=
# e.g. deployment.environment=prod,service.namespace=messaging
OTEL_RESOURCE_ATTRIBUTES=
# The collector's base URL; /v1/traces, /v1/metrics and /v1/logs are appended. e.g. http://collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# http/protobuf (the default) or grpc for traces and logs; metrics always go over HTTP, so with grpc
# give them their own OTEL_EXPORTER_OTLP_METRICS_ENDPOINT on the collector's HTTP port.
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Headers sent with every export, comma-separated key=value pairs, e.g. authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
# Set each to otlp to export that signal; unset, it is not exported.
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_LOGS_EXPORTER=
# Rahdar keeps every trace by default. e.g. parentbased_traceidratio with 0.1 keeps one in ten.
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
# Context propagation formats, e.g. tracecontext,baggage (the default) or b3.
OTEL_PROPAGATORS=
# How often metrics are exported, in milliseconds (default 60000).
OTEL_METRIC_EXPORT_INTERVAL=
