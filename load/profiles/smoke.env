# A minute-long check that the load test itself works: a handful of everything. Not a measurement.
: "${LOAD_BROKERS:=1}"
: "${LOAD_CLUSTERS:=1}"
: "${LOAD_NODES_PER_CLUSTER:=1}"
: "${LOAD_QUEUES:=150}"
: "${LOAD_MESSAGES:=2000}"
: "${LOAD_AUDIT_ROWS:=40}"
: "${LOAD_ACCOUNTS:=4}"
: "${LOAD_UI_USERS:=3}"
: "${LOAD_SSE_FAST:=2}"
: "${LOAD_SSE_STALLED:=1}"
: "${LOAD_EXPORTS:=3}"
: "${LOAD_SQL:=3}"
: "${LOAD_DURATION:=30}"
: "${LOAD_RAMP:=5}"
