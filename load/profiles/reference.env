# The profile behind docs/sizing.md: a replicated Studio and Postgres on one 4 vCPU / 8 GB machine,
# brokers beside them. Every value can be overridden from the environment (LOAD_QUEUES=5000 just load).
: "${LOAD_BROKERS:=3}"
: "${LOAD_CLUSTERS:=3}"
: "${LOAD_NODES_PER_CLUSTER:=3}"
: "${LOAD_QUEUES:=1000}"
: "${LOAD_MESSAGES:=30000}"
: "${LOAD_AUDIT_ROWS:=300}"
: "${LOAD_ACCOUNTS:=40}"
: "${LOAD_UI_USERS:=30}"
: "${LOAD_SSE_FAST:=40}"
: "${LOAD_SSE_STALLED:=10}"
: "${LOAD_EXPORTS:=4}"
: "${LOAD_SQL:=4}"
: "${LOAD_DURATION:=300}"
: "${LOAD_RAMP:=30}"
