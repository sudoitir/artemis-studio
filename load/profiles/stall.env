# Event-stream subscribers that stop reading, under heavy broker traffic, to see the server drop them
# (three overflows or a write blocked for 30 s, ADR-0197) while its memory stays flat. Not a measurement of sizing.
: "${LOAD_CLUSTERS:=1}"
: "${LOAD_NODES_PER_CLUSTER:=2}"
: "${LOAD_QUEUES:=200}"
: "${LOAD_MESSAGES:=2000}"
: "${LOAD_AUDIT_ROWS:=20}"
: "${LOAD_ACCOUNTS:=8}"
: "${LOAD_UI_USERS:=3}"
: "${LOAD_SSE_FAST:=5}"
: "${LOAD_SSE_STALLED:=30}"
: "${LOAD_EXPORTS:=0}"
: "${LOAD_SQL:=0}"
: "${LOAD_DURATION:=150}"
: "${LOAD_RAMP:=10}"
: "${LOAD_CHURN:=6}"
: "${LOAD_TCP_WMEM:=4096 4096 4096}"
export LOAD_TCP_WMEM
: "${LOAD_TIER_AB:=1s}"
export LOAD_TIER_AB
