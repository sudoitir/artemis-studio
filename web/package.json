{
  "name": "artemis-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Artemis Studio web console",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript openapi.json -o src/kernel/api/schema.d.ts",
    "build": "npm run gen:api && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "shots": "node --experimental-strip-types scripts/shots.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "ui-review": "node --experimental-strip-types scripts/ui-review.ts",
    "sweep": "node --experimental-strip-types scripts/sweep.ts"
  },
  "dependencies": {
    "@artemis-studio/plugin-sdk": "file:src/sdk",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@mantine/charts": "9.6.3",
    "@mantine/code-highlight": "9.6.3",
    "@mantine/core": "9.6.3",
    "@mantine/dates": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/notifications": "9.6.3",
    "@mantine/spotlight": "9.6.3",
    "@module-federation/runtime": "2.9.2",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "12.12.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.13",
    "elkjs": "0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "shiki": "^4.4.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.22.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/router-plugin": "1.168.41",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@module-federation/dts-plugin": {
      "undici": "7.29.1"
    }
  }
}
