{
  "name": "artemis-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Artemis Studio web console",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "build": "npm run gen:api && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mantine/charts": "9.6.0",
    "@mantine/code-highlight": "9.6.0",
    "@mantine/core": "9.6.0",
    "@mantine/dates": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "@mantine/notifications": "9.6.0",
    "@mantine/spotlight": "9.6.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "12.11.6",
    "dayjs": "^1.11.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
