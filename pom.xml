<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.sudoitir</groupId>
    <artifactId>artemis-studio</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Artemis Studio</name>
    <description>Cluster-wide management and observability for Apache ActiveMQ Artemis</description>
    <url>https://github.com/sudoitir/artemis-studio</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- Required by Maven Central for the published plugin API (ADR-0102). -->
    <developers>
        <developer>
            <id>sudoitir</id>
            <name>Mahdi Amirabdollahi</name>
            <url>https://github.com/sudoitir</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/sudoitir/artemis-studio.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/sudoitir/artemis-studio.git</developerConnection>
        <url>https://github.com/sudoitir/artemis-studio</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pinned; verified against Maven Central during workspace setup. -->
        <artemis.version>2.57.0</artemis.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <spotless.version>3.10.2</spotless.version>
        <!-- Publishing the plugin API (ADR-0102); verified against Maven Central 2026-09-23. -->
        <central-publishing.version>0.11.0</central-publishing.version>
        <maven-gpg.version>3.2.8</maven-gpg.version>
        <maven-source.version>3.4.0</maven-source.version>
        <maven-javadoc.version>3.12.0</maven-javadoc.version>
        <japicmp.version>0.26.2</japicmp.version>
        <palantir-java-format.version>2.97.0</palantir-java-format.version>

        <!-- Lombok version comes from the Spring Boot BOM. MapStruct and the
             Lombok↔MapStruct binding are not BOM-managed (ADR-0014). -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- springdoc 3.x is the Spring Boot 4 line (ADR-0019). -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- MCP server (ADR-0045). 2.0.1, never 2.0.0: that release's STREAMABLE
             transport retained sessions without bound (CVE-2026-59279). -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- SPIKE (ADR-0047): latest train is 2025.1.3, built against Boot 4.0.8.
             There is no Boot 4.1 train yet. Kept only if the context actually starts. -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <!-- SQL Console dialect parser (ADR-0058). Not BOM-managed. -->
        <jsqlparser.version>5.4</jsqlparser.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <node.version>v24.21.0</node.version>

        <!-- The frontend build is opt-in so `mvn test` stays fast in day-to-day work.
             CI and the Docker image activate the `frontend` profile. -->
        <skip.frontend>true</skip.frontend>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4.x no longer manages the Testcontainers versions itself. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Module boundaries verified at build time (ADR-0069). -->
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- MVC + Tomcat + SseEmitter for SSE (ADR-0003, Phase 2).
                 No WebFlux — nothing needs reactive. -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <!-- Blocking RestClient for Jolokia (ADR-0010). Boot 4 splits this
                 out of starter-web; it brings HttpClientSettings +
                 ClientHttpRequestFactoryBuilder and the RestClient.Builder bean. -->
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <!-- SMTP for email notification channels (ADR-0099). Studio builds one sender per
                 channel; the auto-configured global JavaMailSender is unused and backs off
                 without spring.mail.host. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <!-- @ApplicationModule / @NamedInterface declarations only; no runtime (ADR-0069). -->
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- OIDC login (Phase 8, ADR-0040). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- Session store for cookie-based auth (Phase 8, ADR-0037); schema owned
             by our own Liquibase changeset (014-identity.sql), never the
             library's auto-initializer. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- MCP server over the existing MVC stack, stateless (ADR-0045). Version
             from the spring-ai BOM imported above. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Boilerplate + mapping (ADR-0014). Lombok is compile-only; MapStruct's
             runtime is tiny (annotations + a helper). Processors are wired in the
             compiler plugin below. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Schema migrations: Liquibase, XML master changelog + SQL changesets.
             Boot 4 splits auto-configuration per module; this starter brings
             liquibase-core and the spring-boot-liquibase auto-configuration.
             Version (5.0.3) is managed by the Boot BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Artemis Core / JMS client: the second broker channel (activemq.notifications,
             faithful message I/O). Not exercised until Phase 4, pinned now so the
             dependency surface is fixed. -->
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
            <version>${artemis.version}</version>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Phase 5: pools the Core connection the request-reply sampler and
             CoreMessageTransport share, instead of opening one per call
             (ADR-0031). Version managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>org.messaginghub</groupId>
            <artifactId>pooled-jms</artifactId>
        </dependency>

        <!-- Phase 5: the correlator's hot in-flight-flow lookup cache, in front
             of rr_flow (design.md D5). Version managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- The SQL Console's dialect parser (ADR-0058). Studio parses to an AST
             and validates every node against a whitelist; JSqlParser supplies the
             tree, never the authorization. -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>${jsqlparser.version}</version>
        </dependency>

        <!-- OpenAPI 3 document at /v3/api-docs (+ Swagger UI). The frontend's
             web/src/kernel/api/schema.d.ts is generated from a committed snapshot of
             this document (ADR-0019, primary path taken in Phase 3). The 3.x
             line is built against Spring Boot 4.1.0. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- ApplicationModules.verify(), @ApplicationModuleTest, module canvases (ADR-0069). -->
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>artemis-studio</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- The runnable jar is target/artemis-studio-exec.jar (the image, the release
                         asset). The plain jar keeps the main artifact's name: it is the plugin API
                         plugins compile against, published to Maven Central (ADR-0102). -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <!-- Bakes the running version into META-INF/build-info.properties, read
                         by StudioVersion (kernel.plugin) for the plugin compatibility range. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Annotation processors, in order (ADR-0014): Lombok, then the
                 Lombok↔MapStruct binding, then the MapStruct processor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Palantir Java Format via Spotless, applied at compile time:
                 `spotless:apply` is bound to process-sources, so every `mvn compile`
                 (and the IDE's build) reformats sources first. `mvn spotless:check`
                 runs in `verify` and fails CI on drift.
                 Needs the JDK compiler exports in .mvn/jvm.config. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-apply</id>
                        <phase>process-sources</phase>
                        <goals><goal>apply</goal></goals>
                    </execution>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Liquibase CLI for schema authoring and ops. Runtime migration is
                 done by Spring Boot on startup; this plugin is for humans:
                   mvn liquibase:updateSQL      preview the SQL a changeset emits
                   mvn liquibase:status         what is pending
                   mvn liquibase:rollback -Dliquibase.rollbackCount=1
                   mvn liquibase:diff           drift between changelog and a live DB
                 Reads db connection from liquibase.properties (git-ignored values
                 via env). Version managed by the Boot BOM (5.0.3). -->
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <configuration>
                    <propertyFile>liquibase.properties</propertyFile>
                    <searchPath>${project.basedir},${project.basedir}/src/main/resources</searchPath>
                    <changeLogFile>db/changelog/db.changelog-master.xml</changeLogFile>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `-Prelease`: the plugin API to Maven Central (ADR-0102). Sources, javadoc and GPG
             signatures are what Central requires; the Central plugin uploads and publishes. The
             passphrase comes from MAVEN_GPG_PASSPHRASE and the token from settings.xml server
             `central` (CI writes both from secrets). Run with -Dspring-boot.repackage.skip=true:
             Central gets the plain jar, its sources and javadoc, never the runnable exec jar. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg.version}</version>
                        <configuration>
                            <!-- Reads MAVEN_GPG_PASSPHRASE; never a passphrase on the command line. -->
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `-Papi-check`: the plugin API may not break within a contract version (ADR-0102).
             Compares every @PluginApi type with the latest release on Maven Central; with no
             release yet there is nothing to compare, and it passes. A deliberate break bumps
             Contract.VERSION and is released with -Djapicmp.skip. -->
        <profile>
            <id>api-check</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <version>${japicmp.version}</version>
                        <configuration>
                            <oldVersion>
                                <dependency>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>RELEASE</version>
                                </dependency>
                            </oldVersion>
                            <newVersion>
                                <file>
                                    <path>${project.build.directory}/${project.build.finalName}.jar</path>
                                </file>
                            </newVersion>
                            <parameter>
                                <includes>
                                    <include>@io.github.sudoitir.artemisstudio.kernel.plugin.PluginApi</include>
                                </includes>
                                <onlyModified>true</onlyModified>
                                <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                                <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                                <skipPomModules>false</skipPomModules>
                            </parameter>
                        </configuration>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>cmp</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Activate with `-Pfrontend` (CI, Docker). Builds web/ with a managed Node,
             then copies web/dist into the jar's static resources. -->
        <profile>
            <id>frontend</id>
            <properties>
                <skip.frontend>false</skip.frontend>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <configuration>
                            <workingDirectory>web</workingDirectory>
                            <installDirectory>${project.build.directory}/node</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals><goal>install-node-and-npm</goal></goals>
                                <configuration>
                                    <nodeVersion>${node.version}</nodeVersion>
                                </configuration>
                            </execution>
                            <execution>
                                <id>npm-ci</id>
                                <goals><goal>npm</goal></goals>
                                <configuration><arguments>ci</arguments></configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <goals><goal>npm</goal></goals>
                                <phase>prepare-package</phase>
                                <configuration><arguments>run build</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>web/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
