# Root of the Lombok config tree (ADR-0014).
config.stopBubbling = true

# Mark generated members so JaCoCo, Spotless, and static analysis skip them,
# and so MapStruct's processor sees Lombok's accessors.
lombok.addLombokGeneratedAnnotation = true

# @RequiredArgsConstructor / @AllArgsConstructor also emit @ConstructorProperties,
# which helps Jackson and other reflective binders name parameters.
lombok.anyConstructor.addConstructorProperties = true
